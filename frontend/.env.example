# Frontend Production Environment Variables
# For Local Development (leave blank or empty to use Vite local proxy to http://127.0.0.1:8000/api):
# VITE_API_URL=

# For Production (Cloudflare Pages pointing to Render backend):
# Replace with your actual Render service URL (e.g., https://aim-v0-backend.onrender.com/api)
VITE_API_URL=https://your-backend-app.onrender.com/api
